#!/usr/bin/env bash
# wick: Sober (Roblox's Android client) fully offline, with Waxley as its backend.
#   - a frozen fork of Sober: the Sober app pinned in wick's own flatpak installation (masked, its
#     remote disabled, invisible to your desktop) and its own copy of the Roblox APK + unpacked
#     assets (never your cookies or login), bind-mounted over
#     ~/.var/app/org.vinegarhq.Sober inside the namespace only. Updates to your real Sober don't
#     reach it (sober/poke.py's offsets are tied to this build); `wick --update` re-forks on purpose
#   - mockblox.py answers DNS and the Roblox web endpoints (routes.py)
#   - optionally a game server for Sober to join: Waxley's Studio with -task StartServer, hidden in
#     a headless gamescope
# Everything runs in one network namespace with loopback + a dummy os0 and no route anywhere. The
# session bus and Discord's IPC socket are masked, so nothing gets handed to the host either.
#
#   wick [place.rbxl|.rbxlx] [--hidden] [--url roblox://...] [--update]
#     place     a place to host and join; without one, Sober just opens (home screen)
#     --hidden  Sober in a headless gamescope (testing; also WICK_HIDDEN=1)
#     --url     launch URL for Sober (default: the hosted place, if any)
#     --update  re-copy the fork from your installed Sober (breaks poke.py until its offsets are redone)
# Ctrl+C, or closing Sober, shuts it all down.
set -euo pipefail

SELF=$(realpath "$0")
HERE=$(dirname "$SELF")
export DATA=${WAXLEY_DATA:-$HOME/.local/share/waxley}
export WAXLEY_DATA=$DATA
export WD=$DATA/wick
export RUN=$WD/run
export SOBER=$HOME/.var/app/org.vinegarhq.Sober
# The fork's private flatpak installation. Sober refuses to run from anywhere but a normal install
# (check_security), and `flatpak run --app-path` makes it fall back from Vulkan to a GL that
# crashes, so inside wick's namespace the fork's deployment is bind-mounted over the system one.
export FORK_FLATPAK=$WD/flatpak
fork() { FLATPAK_USER_DIR=$FORK_FLATPAK flatpak --user "$@"; }
export -f fork
export WINE_ROOT=${WAXLEY_WINE:-$HOME/.var/app/org.vinegarhq.Vinegar/data/vinegar/kombucha}
export SERVER_PORT=${WICK_PORT:-53650}
# What Sober is told the hosted place is (any id; mockblox maps it to the local server)
export PLACE_ID=${WICK_PLACE_ID:-8999000000000001}

# Fail closed: only lo and the dummy os0 may exist, and no route may exist outside the kernel's
# "local" table (addresses on this host). Anything else = a way out, so refuse.
sandbox_check() {
	local bad=""
	while read -r _ name type; do
		case "$name:$type" in lo:loopback | os0:dummy) ;; *) bad+="interface $name ($type); " ;; esac
	done < <(ip -o -d link show | awk '{n=$2; sub(":$","",n); sub("@.*","",n); t="other";
		if ($0 ~ /link\/loopback/) t="loopback"; else if ($0 ~ / dummy /) t="dummy"; print 0, n, t}')
	local r
	while read -r r; do
		[[ -z $r ]] && continue
		case "$r" in local\ * | broadcast\ * | multicast\ * | anycast\ *) [[ $r == *" table local "* ]] && continue ;; esac
		bad+="route [$r]; "
	done < <(ip -o route show table all; ip -o -6 route show table all)
	if [[ -n $bad ]]; then
		echo "wick: sandbox not sealed, refusing to run: $bad" >&2
		return 1
	fi
}
export -f sandbox_check

case ${WAXLEY_STAGE:-host} in
host)
	PLACE="" HIDDEN=${WICK_HIDDEN:-0} URL="" UPDATE=0
	while (($#)); do
		case $1 in
		--hidden) HIDDEN=1 ;;
		--update) UPDATE=1 ;;
		--url) URL=$2; shift ;;
		--url=*) URL=${1#*=} ;;
		-h | --help) sed -n '2,16p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) PLACE=$1 ;;
		esac
		shift
	done
	command -v flatpak >/dev/null && flatpak info --system org.vinegarhq.Sober >/dev/null 2>&1 ||
		{ echo "wick: Sober (org.vinegarhq.Sober) isn't installed (wick runs its fork in place of it)" >&2; exit 1; }
	[[ -z $PLACE || -f $PLACE ]] || { echo "wick: no such place $PLACE" >&2; exit 2; }
	mkdir -p "$RUN" "$WD/etc"
	exec 9>"$RUN/lock"
	flock -n 9 || { echo "wick is already running" >&2; exit 1; }

	printf 'nameserver 127.0.0.1\n' >"$WD/etc/resolv.conf"
	printf 'hosts: files dns\n' >"$WD/etc/nsswitch.conf"
	printf '127.0.0.1 localhost\n::1 localhost\n10.77.0.2 %s\nfd77::2 %s\n' "$(hostname)" "$(hostname)" >"$WD/etc/hosts"
	: >"$WD/etc/empty"

	# The fork: the Sober app + the Roblox APK and its unpacked assets, copied once (or on --update)
	# and never refreshed from your installed Sober after that; none of Sober's cookies, storage or logs
	PS=$WD/sober/data/sober
	mkdir -p "$PS/appData" "$WD/sober/config/sober" "$WD/sober/cache" "$WD/sober/wick"
	APK=$PS/packages/x86_64/com.roblox.client
	if [[ $UPDATE == 1 || ! -f $APK/base.apk ]]; then
		echo "wick: forking Sober's Roblox APK + assets" >&2
		rm -rf "$PS/packages" "$PS/assets"
		cp -a --reflink=auto "$SOBER/data/sober/packages" "$SOBER/data/sober/assets" "$PS/"
		cp "$SOBER/data/sober/state" "$PS/state"
	fi
	if [[ $UPDATE == 1 ]] || ! fork info org.vinegarhq.Sober >/dev/null 2>&1; then
		echo "wick: forking the Sober app ($(flatpak info org.vinegarhq.Sober | sed -n 's/^ *Version: //p'))" >&2
		bundle=$WD/sober.flatpak
		flatpak build-bundle "$(flatpak info -l org.vinegarhq.Sober | sed 's#/app/org.vinegarhq.Sober/.*#/repo#')" \
			"$bundle" org.vinegarhq.Sober stable
		fork mask --remove org.vinegarhq.Sober 2>/dev/null || true
		fork uninstall --noninteractive org.vinegarhq.Sober >/dev/null 2>&1 || true
		fork install --noninteractive --bundle "$bundle" >/dev/null
		fork mask org.vinegarhq.Sober
		for r in $(fork remotes --columns=name); do fork remote-modify --disable "$r"; done
		rm -f "$bundle"
	fi
	# The engine's own (static) curl only sets CURLOPT_CAINFO if <data>/exe/ssl/cacert.pem (or
	# exe/cacert.pem) exists; Sober leaves exe/ empty, so put the APK's list + wick's CA there
	mkdir -p "$PS/exe/ssl"
	{ unzip -p "$APK/base.apk" assets/ssl/cacert.pem; python3 "$HERE/sober/wickblox.py" --ca; } >"$PS/exe/ssl/cacert.pem"
	rm -f "$PS/asset_overlay/ssl/cacert.pem"
	# ...and reads FastFlags from <data>/exe/ClientSettings/ClientAppSettings.json, like desktop Roblox
	mkdir -p "$PS/exe/ClientSettings"
	python3 -c 'import json, sys; d = json.load(open(sys.argv[1]))
json.dump({k: v for k, v in d.items() if not k.startswith("_")}, open(sys.argv[2], "w"), indent=2)' \
		"$HERE/sober/fflags.json" "$PS/exe/ClientSettings/ClientAppSettings.json"
	# A fake session (Sober's cookie jar is one Cookie: line), so the app starts logged in as the
	# mock user; it only ever reaches mockblox
	uid=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["id"])' "$DATA/mock/user.json")
	printf '.ROBLOSECURITY=_|WARNING:-wick-offline-fake-session|_WICK%s; RBXEventTrackerV2=CreateDate=1/1/2026 00:00:00&rbxid=%s&browserid=1' \
		"$uid" "$uid" >"$PS/cookies"
	# Sober's own downloads use the flatpak runtime's libcurl and CA bundle: inside the namespace
	# the bundle gets mockblox's CA too, and libcurl is wrapped (sober/curlshim.c) so a CA list
	# Sober sets itself is swapped for that bundle
	export FORK_DEPLOY=$(fork info -l org.vinegarhq.Sober) SYS_DEPLOY=$(flatpak info --system -l org.vinegarhq.Sober)
	RT=$(flatpak info -l "$(fork info --show-runtime org.vinegarhq.Sober)")/files
	export RT_CA=$RT/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
	{ cat "$RT_CA"; python3 "$HERE/sober/wickblox.py" --ca; } >"$WD/sober/wick/ca-bundle.pem"
	export RT_CURL=$(readlink -f "$RT/lib/x86_64-linux-gnu/libcurl.so.4")
	if [[ ! -e $WD/curlshim.so || $HERE/sober/curlshim.c -nt $WD/curlshim.so || $RT_CURL -nt $WD/curlshim.so ]]; then
		python3 -c 'import sys; b = open(sys.argv[1], "rb").read(); open(sys.argv[2], "wb").write(b.replace(b"libcurl.so.4\0", b"libcurX.so.4\0", 1))' \
			"$RT_CURL" "$WD/sober/wick/libcurX.so.4"
		gcc -shared -fPIC -O2 -Wl,-soname,libcurl.so.4 -DWICK_CA_BUNDLE="\"$SOBER/wick/ca-bundle.pem\"" \
			-o "$WD/curlshim.so" "$HERE/sober/curlshim.c" -L"$WD/sober/wick" -l:libcurX.so.4 -Wl,-rpath,"$SOBER/wick" -ldl
	fi
	# Sober settings: yours, minus Discord rich presence; FastFlags from sober/fflags.json on top
	python3 - "$SOBER/config/sober/config.json" "$HERE/sober/fflags.json" >"$WD/sober/config/sober/config.json" <<-'EOF'
		import json, os, re, sys
		src, flags = sys.argv[1:]
		try:
		    cfg = json.loads(re.sub(r"(?m)^\s*//.*$", "", open(src).read()))
		except (OSError, ValueError):
		    cfg = {}
		cfg["discord_rpc_enabled"] = False
		cfg.setdefault("fflags", {})
		if os.path.exists(flags):
		    cfg["fflags"].update({k: v for k, v in json.load(open(flags)).items() if not k.startswith("_")})
		print(json.dumps(cfg, indent=4))
	EOF

	export PLACE_FILE="" HIDDEN URL
	if [[ -n $PLACE ]]; then
		PLACE=$(realpath "$PLACE")
		export PLACE_FILE="Z:${PLACE//\//\\}"
		[[ -z $URL ]] && URL="roblox://placeId=$PLACE_ID"
		# The game server: Waxley's Studio with -task StartServer , from
		# wick's own copy of the install + prefix, so it never touches a running Waxley/Player.
		# Its cacert gets wick's CA, since wickblox (not mockblox) answers inside wick.
		SS=$WD/studio SP=$WD/server-prefix SA=$WD/server-appdata
		if ! cmp -s "$DATA/studio/RobloxStudioBeta.exe" "$SS/RobloxStudioBeta.exe"; then
			echo "wick: copying Waxley's Studio install" >&2
			rm -rf "$SS.new" && cp -a --reflink=auto "$DATA/studio" "$SS.new" && rm -rf "$SS" && mv "$SS.new" "$SS"
		fi
		{ cat "$DATA/studio/ssl/cacert.pem.orig"; python3 "$HERE/sober/wickblox.py" --ca; } >"$SS/ssl/cacert.pem"
		[[ -d $SP && -d $SA ]] || { echo "wick: the game server prefix ($SP) is missing" >&2; exit 1; }
		mkdir -p "$SA/Roblox/ClientSettings"
		python3 -c 'import json, sys; base, extra, *out = sys.argv[1:]; f = json.load(open(base))
f.update({k: v for k, v in json.load(open(extra)).items() if not k.startswith("_")})
[json.dump(f, open(o, "w"), indent=2) for o in out]' "$DATA/studio/ClientSettings/ClientAppSettings.json" \
			"$HERE/sober/server-flags.json" "$SS/ClientSettings/ClientAppSettings.json" "$SA/Roblox/ClientSettings/ClientAppSettings.json"
		WAXLEY_PREFIX=$SP python3 "$HERE/creds.py" seed >/dev/null
		cp --reflink=auto "$PLACE" "$SP/drive_c/users/$USER/AppData/Local/Roblox/server.rbxl"
		cp --reflink=auto "$PLACE" "$SA/Roblox/server.rbxl"
		export SS SP
	fi

	WAXLEY_STAGE=root OUTER_UID=$(id -u) OUTER_GID=$(id -g) \
		exec unshare --user --map-root-user --net --mount --propagation private "$SELF"
	;;

root)
	ip link set lo up
	# A fake LAN address (Studio's server wants a non-loopback adapter). No route to anywhere:
	# the connected subnet routes are deleted, only the "local" table entries stay.
	ip link add os0 type dummy
	ip link set os0 up
	ip addr add 10.77.0.2/24 dev os0 noprefixroute
	ip -6 addr add fd77::2/64 dev os0 nodad noprefixroute
	ip -6 route flush table main 2>/dev/null || true
	ip route flush table main 2>/dev/null || true
	echo 0 >/proc/sys/net/ipv4/ip_unprivileged_port_start
	for f in resolv.conf nsswitch.conf hosts; do mount --bind "$WD/etc/$f" "/etc/$f"; done
	[[ -d /run/systemd/resolve ]] && mount -t tmpfs none /run/systemd/resolve
	# Sober sees wick's copy instead of your real Sober data
	mount --bind "$WD/sober" "$SOBER"
	# ...and runs the fork's frozen app wherever your real Sober is currently deployed
	mount --bind "$FORK_DEPLOY" "$SYS_DEPLOY"
	mount --bind "$WD/sober/wick/ca-bundle.pem" "$RT_CA"
	mount --bind "$WD/curlshim.so" "$RT_CURL"
	# No session/system bus (portals could open things on the host) and no Discord IPC
	xdg=${XDG_RUNTIME_DIR:-/run/user/$OUTER_UID}
	for s in "$xdg/bus" /run/dbus/system_bus_socket "$xdg"/discord-ipc-*; do
		[[ -S $s ]] && mount --bind "$WD/etc/empty" "$s"
	done
	[[ -d $xdg/app/com.discordapp.Discord ]] && mount -t tmpfs none "$xdg/app/com.discordapp.Discord"
	sandbox_check || exit 3
	WAXLEY_STAGE=user exec unshare --user --map-user="$OUTER_UID" --map-group="$OUTER_GID" "$SELF"
	;;

user)
	sandbox_check || exit 3
	unset DBUS_SESSION_BUS_ADDRESS DBUS_SYSTEM_BUS_ADDRESS
	pids=()
	stop() {
		trap - EXIT INT TERM HUP
		echo "wick: shutting down" >&2
		# (no `flatpak kill`: that would take your real Sober down too; the tree below is ours)
		[[ -n $PLACE_FILE ]] && WINEPREFIX=$WD/server-prefix timeout 15 "$WINE_ROOT/bin/wineserver" -k 2>/dev/null || true
		# everything started from here (the server's gamescope doesn't go away with its parent)
		local tree=() p
		descend() { local c; for c in $(pgrep -P "$1"); do tree+=("$c"); descend "$c"; done; }
		descend $$
		for p in "${tree[@]}"; do kill "$p" 2>/dev/null; done
		sleep 1
		for p in "${tree[@]}"; do kill -9 "$p" 2>/dev/null; done
		# gamescopereaper gets reparented away from us; anything still running wick's Studio copy goes too
		[[ -n $PLACE_FILE ]] && pkill -9 -f "$WD/studio/RobloxStudioBeta" 2>/dev/null
		kill "${pids[@]}" 2>/dev/null || true
		wait 2>/dev/null || true
	}
	trap stop EXIT
	trap 'exit 130' INT TERM HUP

	: >"$RUN/requests.log"
	WAXLEY_LOG=$RUN/requests.log WAXLEY_DEBUG=${WICK_DEBUG:-} python3 "$HERE/sober/wickblox.py" 2>>"$RUN/mockblox.err" &
	pids+=($!)
	( while sleep 2; do sandbox_check 2>>"$RUN/watchdog.log" || { kill -TERM $$; exit; }; done ) &
	pids+=($!)
	for _ in $(seq 50); do [[ -s $RUN/requests.log ]] && break; sleep 0.1; done

	# hidden <w> <h> cmd...: run cmd in its own headless gamescope with a private /tmp/.X11-unix
	# (Xwayland wants that dir owned by us or root; the host's belongs to the real root)
	hidden() {
		local w=$1 h=$2; shift 2
		unshare --user --map-root-user --mount bash -c '
			mount -t tmpfs -o mode=1777 tmpfs /tmp/.X11-unix
			u=$1 g=$2 w=$3 h=$4; shift 4
			exec unshare --user --map-user="$u" --map-group="$g" gamescope --backend headless -W "$w" -H "$h" -- \
				env -u WAYLAND_DISPLAY "$@"' _ "$(id -u)" "$(id -g)" "$w" "$h" "$@"
	}

	if [[ -n ${WICK_CMD:-} ]]; then bash -c "$WICK_CMD"; exit; fi  # debugging hook

	if [[ -n $PLACE_FILE ]]; then
		uid=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["id"])' "$DATA/mock/user.json")
		echo "wick: starting the game server on udp/$SERVER_PORT" >&2
		(
			cd "$SS"
			export WINEPREFIX=$SP WINEDEBUG=${WINEDEBUG:--all} WINEESYNC=1 WINEFSYNC=1
			export WINEDLLOVERRIDES="winemenubuilder.exe=d;winebrowser.exe=d"
			exec bash -c "$(declare -f hidden); hidden 1280 720 \"\$@\"" _ "$WINE_ROOT/bin/wine" "$SS/RobloxStudioBeta.exe" \
				-task StartServer -localProjectFile "$PLACE_FILE" -placeId 0 -universeId 0 -creatorId "$uid" \
				-creatorType 0 -placeVersion 0 -port "$SERVER_PORT" -numTestServerPlayersUponStartup 0 \
				-instanceId WickServer
		) >"$RUN/server.log" 2>&1 9>&- &
		pids+=($!)
		port=":$(printf %04X "$SERVER_PORT") "
		for _ in $(seq 600); do grep -qi "$port" /proc/net/udp /proc/net/udp6 && break; sleep 0.5; done
		grep -qi "$port" /proc/net/udp /proc/net/udp6 || { echo "wick: the server never started (see $RUN/server.log)" >&2; exit 1; }
		echo "wick: server is up" >&2
	fi

	sober=(flatpak run --system)
	for e in ${WICK_SOBER_ENV:-}; do sober+=(--env="$e"); done  # debugging: extra env for Sober
	sober+=(org.vinegarhq.Sober)
	[[ -n $URL ]] && sober+=(-- "$URL")
	echo "wick: starting Sober ${URL:-(home)}" >&2
	if [[ $HIDDEN == 1 ]]; then
		hidden 1600 900 "${sober[@]}" >"$RUN/sober.log" 2>&1 9>&- &
	else
		"${sober[@]}" >"$RUN/sober.log" 2>&1 &
	fi
	spid=$!
	pids+=($spid)
	wait "$spid" 2>/dev/null || true
	;;
esac
