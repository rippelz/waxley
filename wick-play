#!/usr/bin/env bash
# wick-play: host a place with wick and join it in Sober, with sober/poke.py forcing the
# RbxTransport flags while the engine starts up (without that, the engine picks RakNet and the
# join fails). poke.py needs root, so this asks sudo up front.
#
#   wick-play [place.rbxl|.rbxlx] [wick args...]
#     place  default: the last place played, else ~/.local/share/waxley/wick/places/baseplate.rbxl
set -euo pipefail
# the launcher's desktop session can have a bare PATH; the prep needs lune from ~/.local/bin
export PATH="$HOME/.local/bin:$PATH"
# wick also expects USER (wine prefix paths); desktop sessions don't always set it
export USER="${USER:-$(id -un)}"

SELF=$(realpath "$0")
HERE=$(dirname "$SELF")
DATA=${WAXLEY_DATA:-$HOME/.local/share/waxley}
LAST=$DATA/wick/last-place

PLACE=
if [[ ${1:-} == *.rbxl || ${1:-} == *.rbxlx ]]; then PLACE=$(realpath "$1"); shift; fi
[[ -z $PLACE && -f $LAST ]] && PLACE=$(<"$LAST")
[[ -z $PLACE || ! -f $PLACE ]] && PLACE=$DATA/wick/places/baseplate.rbxl
echo "$PLACE" >"$LAST"

# The Android engine only runs bytecode, so a raw Studio export needs wick's prep first
# (PlayerModule + default player scripts added, client scripts compiled to bytecode, source twins).
# The prepped copy lives next to the original as <name>-wick.rbxl, refreshed when the original changes;
# a place that is already a -wick file goes through as it is
if [[ $PLACE == *-wick.rbxl ]]; then
	PREP=$PLACE
else
	PREP=${PLACE%.*}-wick.rbxl
	if [[ ! -f $PREP || $PLACE -nt $PREP ]]; then
		echo "wick-play: preparing $PLACE for the engine" >&2
		python3 "$HERE/sober/wick_place.py" "$PLACE" "$PREP" 1>&2
	fi
fi
PLACE=$PREP

sudo true  # prompt now if a password is needed, not mid-launch
sudo python3 "$HERE/sober/poke.py" >"$DATA/wick/poke.log" 2>&1 &
POKE=$!
trap 'sudo kill $POKE 2>/dev/null || true' EXIT

echo "wick-play: $PLACE"
"$HERE/wick" "$PLACE" "$@"
